{
  "name": "reserved-domain-placeholder",
  "version": "1.0.0",
  "private": true,
  "description": "Single-page holding site for {{FULL_NAME}} — www.{{DOMAIN}}",
  "license": "MIT",
  "scripts": {
    "css": "tailwindcss -i ./styles/tailwind.css -o ./src/styles.css",
    "dev": "concurrently -k \"npm:css -- --watch\" \"browser-sync start --server src --files 'src/**/*' --no-notify\"",
    "build": "npm run css -- --minify && rm -rf _site && mkdir -p _site && cp -R src/. _site/ && cp CNAME _site/",
    "clean": "rm -rf _site src/styles.css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.4"
  }
}
